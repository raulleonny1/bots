<%- include('partials/head') %>
<%- include('partials/nav', { activeNav: 'dashboard' }) %>

<div class="page-hero page-hero--compact">
  <img src="/assets/logo.png" alt="" class="page-hero__logo" width="56" height="56">
  <h1>Estado del bot</h1>
  <p>
    WhatsApp Cloud API (Meta)
    <span id="liveBadge" class="badge <%= bot.status === 'ready' ? 'bg-success' : 'bg-warning text-dark' %> ms-1">
      <%= bot.status === 'ready' ? 'Activo' : 'Revisar config' %>
    </span>
  </p>
</div>

<% if (typeof menuSaved !== 'undefined' && menuSaved) { %>
<div class="alert alert-success alert-dismissible fade show" role="alert">
  Menú guardado en Firebase. Ya está activo en WhatsApp (prueba en unos segundos).
  <a href="/menu" class="alert-link">Volver al menú</a>
  <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
</div>
<% } %>
<% if (typeof menuError !== 'undefined' && menuError) { %>
<div class="alert alert-danger alert-dismissible fade show" role="alert">
  No se pudo guardar el menú en Firebase. Revisa en Vercel: <code>FIREBASE_ENABLED</code>, email y private key.
  <a href="/menu" class="alert-link">Reintentar</a>
  <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
</div>
<% } %>

<div class="howto-strip">
  <div class="howto-step">
    <span class="howto-step__num">1</span>
    <div>
      <strong>Menu</strong>
      <p>Edita opciones y textos en <a href="/menu">Menu</a>.</p>
    </div>
  </div>
  <div class="howto-step">
    <span class="howto-step__num">2</span>
    <div>
      <strong>Webhook</strong>
      <p><code><%= typeof webhookUrl !== 'undefined' ? webhookUrl : 'https://www.botselbuenpastor.online/webhook' %></code></p>
    </div>
  </div>
  <div class="howto-step">
    <span class="howto-step__num">3</span>
    <div>
      <strong>Firebase</strong>
      <% if (typeof firebaseReady !== 'undefined' && firebaseReady) { %>
      <p class="text-success mb-0">Conectado</p>
      <% } else { %>
      <p class="text-danger mb-0">No conectado</p>
      <% if (typeof firebaseError !== 'undefined' && firebaseError) { %>
      <p class="small text-muted mb-0"><%= firebaseError %></p>
      <% } else { %>
      <p class="small text-muted mb-0">Revisa variables en Vercel</p>
      <% } %>
      <% } %>
    </div>
  </div>
</div>

<div class="card shadow-sm mb-4 border-0 dash-card">
  <div class="card-header bg-white fw-semibold">
    <i class="bi bi-cloud-check me-2 text-success"></i> WhatsApp
  </div>
  <div class="card-body">
    <% if (bot.status === 'ready') { %>
    <p class="mb-2"><span class="status-dot status-ready"></span> <strong>Listo</strong> — responde por la API de Meta.</p>
    <p class="small text-muted mb-0">No hace falta QR ni PC encendido. Phone number ID: <code><%= bot.number || '-' %></code></p>
    <% } else { %>
    <p class="text-danger mb-2">Faltan <code>WHATSAPP_TOKEN</code> o <code>WHATSAPP_PHONE_NUMBER_ID</code> en Vercel.</p>
    <% } %>
  </div>
</div>

<div class="row g-3 mb-4">
  <div class="col-md-4">
    <div class="card card-stat shadow-sm h-100">
      <div class="card-body">
        <small class="text-muted">Estado</small>
        <h5 class="mt-1 mb-0" id="statusLabel">
          <span class="status-dot status-<%= bot.status === 'ready' ? 'ready' : 'disconnected' %>"></span>
          <%= bot.status === 'ready' ? 'Conectado' : 'Sin configurar' %>
        </h5>
      </div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card card-stat shadow-sm h-100">
      <div class="card-body">
        <small class="text-muted">Respuestas auto</small>
        <h5 class="mt-1 mb-0" id="responsesEnabled"><%= settings.responsesEnabled ? 'Activadas' : 'Desactivadas' %></h5>
      </div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card card-stat shadow-sm h-100">
      <div class="card-body">
        <small class="text-muted">Mensajes hoy</small>
        <h5 class="mt-1 mb-0" id="msgToday"><%= stats.today %></h5>
      </div>
    </div>
  </div>
</div>

<div class="card shadow-sm mb-4">
  <div class="card-header bg-white fw-semibold">Accesos rapidos</div>
  <div class="card-body d-flex flex-wrap gap-2">
    <a href="/menu" class="btn btn-brand"><i class="bi bi-list-ul me-1"></i>Editar menu</a>
    <a href="/messages" class="btn btn-outline-primary"><i class="bi bi-chat-dots me-1"></i>Mensajes</a>
    <a href="/automations" class="btn btn-outline-secondary"><i class="bi bi-sliders me-1"></i>Automatizaciones</a>
  </div>
</div>

<% const refreshScript = `
<script src="/public/js/live.js"></script>
<script>
window.onLiveStatus = function(data) {
  if (data.stats) {
    var el = document.getElementById('msgToday');
    if (el) el.textContent = data.stats.today;
  }
  if (data.settings) {
    var r = document.getElementById('responsesEnabled');
    if (r) r.textContent = data.settings.responsesEnabled ? 'Activadas' : 'Desactivadas';
  }
};
</script>`; %>
<%- include('partials/foot', { extraScripts: refreshScript }) %>
